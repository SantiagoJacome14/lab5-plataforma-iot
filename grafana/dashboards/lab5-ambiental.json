  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "transparent": true,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "# Lab 5 — Monitoreo ambiental UNAB (toma de 4 días)\n**Qué mira el operador:** que temperatura, humedad e iluminancia se mantengan dentro del rango del escenario (16–32 °C, 35–90 %, 0–800 lx), que lleguen ~360 mensajes por hora (barras abajo a la derecha: una barra baja o ausente = hueco en la toma) y que no haya alertas en rojo."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Temperatura (último valor)",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-lab5"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-lab5"
          },
          "query": "from(bucket: \"lab5\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"ambiental\" and r._field == \"temperature\")\n  |> last()"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "min": 0,
          "max": 50,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 32
              },
              {

# Copia este archivo a ".env" y cambia los valores. ".env" NO se sube al repo.
# Genera un token largo, por ejemplo:  openssl rand -hex 32

INFLUX_USER=lab5admin
INFLUX_PASSWORD=cambia-esta-clave-larga
INFLUX_ORG=unab-lab5
INFLUX_TOKEN=cambia-este-token-por-uno-aleatorio-de-64-hex

# 127.0.0.1 = Grafana solo en esta maquina (PC con Docker Desktop). Usa 0.0.0.0 en una VM remota.
GRAFANA_BIND=127.0.0.1
GRAFANA_USER=admin
GRAFANA_PASSWORD=cambia-esta-clave-grafana
# true = cualquiera con acceso a http://VM:3000 ve el dashboard sin login (solo lectura)
GRAFANA_ANONYMOUS=false

DEVICE_ID=vm-pub-01
# segundos entre mensajes (10 s = ~34.560 puntos por variable en 4 dias)
PUBLISH_INTERVAL=10
